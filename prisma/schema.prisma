generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum MovieGenre {
  ACTION
  COMEDY
  DRAMA
  HORROR
  SCI_FI
  THRILLER
  ANIMATION
  DOCUMENTARY
  ROMANCE
  FANTASY
}

enum MovieRating {
  G // Para todos los públicos
  PG // Guía paternal sugerida
  PG_13 // Guía estricta para menores de 13
  R // Restringido (menores de 17 con adulto)
  NC_17 // Solo adultos (18+)
}

model UserModel {
  id        String   @id @default(uuid()) @map("_id")
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model MovieModel {
  id        String      @id @default(uuid()) @map("_id")
  title     String
  synopsis  String
  duration  Int
  genre     MovieGenre
  rating    MovieRating
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  showtimes ShowtimeModel[]

  @@map("movies")
}

model ShowtimeModel {
  id             String    @id @default(uuid()) @map("_id")
  room           String
  dateTime       DateTime
  price          Float
  totalSeats     Int
  availableSeats Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  movieModel   MovieModel? @relation(fields: [movieModelId], references: [id])
  movieModelId String?

  @@map("showtimes")
}
